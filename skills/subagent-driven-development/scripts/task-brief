#!/usr/bin/env bash
# Extract one task's full text from an implementation plan into a file the
# implementer reads in one call, so the task text never has to be pasted
# through the controller's context.
#
# Usage: task-brief PLAN_FILE TASK_NUMBER
set -euo pipefail

if [ $# -ne 2 ]; then
  echo "usage: task-brief PLAN_FILE TASK_NUMBER" >&2
  exit 2
fi

plan=$1
n=$2
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }
case "$n" in
  ''|*[!0-9]*) echo "invalid task number: $n (must be a positive integer)" >&2; exit 2 ;;
esac
if [ "$n" -eq 0 ]; then
  echo "invalid task number: $n (must be a positive integer)" >&2
  exit 2
fi

dir="$("$(cd "$(dirname "$0")" && pwd)/sdd-workspace" "$plan")"
out="$dir/task-${n}-brief.md"
tmp_out="$out.tmp.$$"

awk -v n="$n" '
  match($0, /^[ ]{0,3}(`{3,}|~{3,})/) {
    seg = substr($0, RSTART, RLENGTH)
    gsub(/^ +/, "", seg)
    mchar = substr(seg, 1, 1)
    mlen = length(seg)
    rest = substr($0, RSTART + RLENGTH)
    if (!infence) { infence = 1; fchar = mchar; flen = mlen }
    else if (mchar == fchar && mlen >= flen && rest ~ /^[ \t]*$/) { infence = 0 }
  }
  !infence && match($0, /^#+/) {
    level = RLENGTH
    if (intask && level <= tasklevel) { intask = 0 }
    if ($0 ~ ("^#+[ \t]+Task[ \t]+" n "([^0-9]|$)")) { intask = 1; tasklevel = level }
  }
  intask { print }
' "$plan" > "$tmp_out"

if [ ! -s "$tmp_out" ]; then
  rm -f "$tmp_out"
  echo "task ${n} not found in ${plan} (no heading matching 'Task ${n}')" >&2
  exit 3
fi

mv -f "$tmp_out" "$out"
echo "wrote ${out}: $(wc -l < "$out" | tr -d ' ') lines"
